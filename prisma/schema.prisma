// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  name      String
  email     String?   @unique
  birthdate DateTime?
  password  String
  phone     String?
  avatar    String?
  bio       String?

  status Boolean @default(true)

  roles Role[] @default([STUDENT])

  // Instituição à qual o usuário pertence (nullable: super-admin futuro não pertence a nenhuma).
  // "Administrar instituições" será uma relação separada (ex: InstitutionAdmin), não este FK.
  institutionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Preenchido quando o usuário conclui (ou pula) o tour inicial da plataforma
  onboardingSeenAt DateTime?

  institution Institution? @relation(fields: [institutionId], references: [id])

  educator Educator?
  student  Student?

  // Relações com Turmas
  classrooms           Classroom[]           @relation("TeacherClassrooms")
  classroomEnrollments ClassroomEnrollment[]

  favorites Favorite[]
  history   History[]

  essayCompletions EssayPromptCompletion[]
}

// Combinações válidas: {STUDENT}, {EDUCATOR}, {EDUCATOR, MANAGER}
enum Role {
  STUDENT
  EDUCATOR
  MANAGER
}

enum LibrasLevel {
  BASICO
  INTERMEDIARIO
  AVANCADO
  FLUENTE
}

// Identifica se o Educator é Professor ou Intérprete dentro da plataforma
enum EducatorType {
  TEACHER
  INTERPRETER
}

// Status de aprovação de contas criadas publicamente (STUDENT)
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// EDUCATOR (Professor e Intérprete)
model Educator {
  id           String       @id @default(uuid())
  userId       String       @unique
  educatorType EducatorType @default(TEACHER)

  // Dados específicos do Professor (opcionais para Intérprete)
  department String?
  specialty  String?

  // Dados específicos do Intérprete (opcionais para Professor)
  certificate        String?
  areaAtuacao        String?
  proficienciaLibras LibrasLevel?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// STUDENT
model Student {
  id                    String         @id @default(uuid())
  userId                String         @unique
  grauEscolar           String
  necessidadesEspeciais String
  status                ApprovalStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// CLASSROOM (Turma)
// Papel do usuário dentro de uma turma. O papel global vem de User.roles;
// aqui só interessa quem ensina e quem aprende naquela turma.
enum ClassRole {
  EDUCATOR
  STUDENT
}

model Classroom {
  id              String  @id @default(uuid())
  name            String
  description     String?
  colorBackground String? // Hexadecimal: ex "#BACA57"
  classCode       String  @unique // Gerado pelo service (ex: "ABC1D2")
  isActive        Boolean @default(true)
  // Turma "Contexto": todos os alunos e educadores são matriculados
  // automaticamente e ela ganha as abas de propostas e exemplos de redação.
  isContext       Boolean @default(false)
  teacherId       String
  institutionId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher     User                  @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  institution Institution?          @relation(fields: [institutionId], references: [id])
  enrollments ClassroomEnrollment[]
  signs       Sign[]                @relation("ClassroomSigns")

  // Conteúdo da turma Contexto (integração com o projeto de redação)
  essayPrompts  EssayPrompt[]
  essayExamples EssayExample[]

  @@index([teacherId])
  @@index([classCode])
  @@index([institutionId])
  @@index([isContext])
}

// ESSAY PROMPT (Proposta de redação — lista de tarefas da turma Contexto)
model EssayPrompt {
  id          String  @id @default(uuid())
  title       String
  description String?
  order       Int     @default(0)
  classroomId String
  creatorId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classroom   Classroom               @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  completions EssayPromptCompletion[]

  @@index([classroomId])
}

// Conclusão individual: cada aluno marca as próprias propostas
model EssayPromptCompletion {
  userId   String
  promptId String

  completedAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt EssayPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@id([userId, promptId])
  @@index([userId])
  @@index([promptId])
}

// ESSAY EXAMPLE (Exemplo de redação — arquivo PDF/imagem no R2)
model EssayExample {
  id          String  @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  classroomId String
  creatorId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId])
}

// CLASSROOM ENROLLMENT (Matrícula)
model ClassroomEnrollment {
  id          String    @id @default(uuid())
  userId      String
  classroomId String
  roleInClass ClassRole

  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  // Um usuário só pode estar matriculado uma vez por turma
  @@unique([userId, classroomId])
  @@index([classroomId])
  @@index([userId])
}

// HAND CONFIG (Configuração de mão para sinais)
model HandConfig {
  id            String  @id @default(uuid())
  name          String  @unique
  imgUrl        String
  institutionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id])
  signs       Sign[]

  @@index([institutionId])
}

// CATEGORY (Categoria do sinal — criada pelos educadores; substitui a antiga classe gramatical)
model Category {
  id    String @id @default(uuid())
  name  String // Rótulo exibido (ex: "Animal")
  value String @unique // Código gerado do nome em UPPER_SNAKE (ex: "ANIMAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signs Sign[]
}

// GLOSSARY DISCIPLINE (Disciplina do glossário global)
// Criada pelo gestor. Diferente de Classroom (turma): não tem código de convite nem matrícula,
// serve apenas para agrupar os sinais públicos por área de conhecimento no glossário global.
model GlossaryDiscipline {
  id          String  @id @default(uuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um sinal pode pertencer a nenhuma, uma ou várias disciplinas do glossário (many-to-many)
  signs Sign[] @relation("GlossaryDisciplineSigns")
}

// SIGN (Sinal de Libras)
// Status de promoção do sinal ao glossário global (público)
enum GlobalStatus {
  PRIVATE // Visível apenas nas disciplinas
  PENDING // Promovido, aguardando aprovação do gestor
  PUBLIC // Aprovado — visível no glossário público
  REJECTED // Recusado pelo gestor (pode ser promovido de novo)
}

model Sign {
  id                  String  @id @default(uuid())
  name                String // Palavra em português
  // Gerado a partir do nome (kebab-case) na criação; fixo depois — trocar o
  // slug quebraria links já compartilhados. Usado na URL em vez do id.
  slug                String  @unique
  categoryId          String
  handConfigId        String
  videoUrl            String? // URL do vídeo upado no R2
  anotherUrl          String? // URL alternativa (ex: YouTube)
  imgUrl              String? // Imagem ilustrativa (opcional)
  examplePt           String? // Exemplo em português
  exampleLibras       String? // Exemplo em Libras
  movementDescription String? // Descrição do movimento
  tags                String[] @default([])
  creatorId           String
  institutionId       String?
  // O sinal continua nas turmas; quando PUBLIC, também fica visível a todos
  globalStatus        GlobalStatus @default(PRIVATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  handConfig HandConfig  @relation(fields: [handConfigId], references: [id])
  // Um sinal pode pertencer a várias turmas (many-to-many)
  classrooms Classroom[] @relation("ClassroomSigns")
  // Disciplinas do glossário global às quais o sinal foi associado ao ser promovido
  glossaryDisciplines GlossaryDiscipline[] @relation("GlossaryDisciplineSigns")
  institution Institution? @relation(fields: [institutionId], references: [id])
  favorites   Favorite[]
  history     History[]

  @@index([handConfigId])
  @@index([creatorId])
  @@index([categoryId])
  @@index([institutionId])
  @@index([globalStatus])
}

// FAVORITE (Sinais favoritados pelo usuário)
model Favorite {
  userId String
  signId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sign Sign @relation(fields: [signId], references: [id], onDelete: Cascade)

  @@id([userId, signId])
  @@index([userId])
  @@index([signId])
}

// HISTÓRICO
model History {
  userId String
  signId String

  accessedAt DateTime @default(now()) @updatedAt
  // Incrementado a cada novo acesso (register) — usado no dashboard do gestor
  // para ranquear sinais mais/menos usados.
  accessCount Int @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sign Sign @relation(fields: [signId], references: [id], onDelete: Cascade)

  @@id([userId, signId])
  @@index([userId])
  @@index([signId])
  @@index([accessedAt])
}

// INSTITUTION
model Institution {
  id   String @id @default(uuid())
  cnpj String @unique
  name String 

  zipCode      String 
  street       String
  number       String 
  complement   String? 
  neighborhood String 
  city         String
  state        String 

  contactEmail String
  contactPhone String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  classrooms  Classroom[]
  signs       Sign[]
  handConfigs HandConfig[]
}

// PARAM (Tabela genérica de parâmetros de selects)
model Param {
  id       String  @id @default(uuid())
  type     String // ex: "GRAMMATICAL_CLASS"
  label    String // ex: "1º Ano do Ensino Médio"
  value    String // ex: "ENSINO_MEDIO_1"
  order    Int     @default(0)
  isActive Boolean @default(true)

  @@unique([type, value])
  @@index([type])
}
